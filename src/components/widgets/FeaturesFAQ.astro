---
import { Check } from "lucide-react";

const benefits = [
  "No long-term contracts - we earn your business every month.",
  "100% exclusivity - we never work with your direct competitors.",
  "Real-time reporting dashboard - see exactly where your money goes.",
  "Specialized industry knowledge - we speak HVAC, plumbing, and electrical.",
];
---

<section class="container py-24 sm:py-32 grid lg:grid-cols-2 gap-12 items-center">
  <div class="space-y-8">
    <h2 class="text-3xl md:text-4xl font-bold">Why Choose ZiaFlow?</h2>
    <p class="text-lg text-muted-foreground">
      We're not just a marketing agency; we're your growth partner. We understand the unique challenges of the home service industry.
    </p>

    <ul class="space-y-4">
      {benefits.map((benefit) => (
        <li class="flex items-start">
          <div class="mt-1 mr-3 bg-primary/10 p-1 rounded-full">
            <Check className="w-4 h-4 text-primary" />
          </div>
          <span class="text-lg">{benefit}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="bg-muted p-8 rounded-2xl">
    <h3 class="text-2xl font-bold mb-4">Quick Questions</h3>
    <div class="space-y-6">
        <div>
            <h4 class="font-semibold">How fast can we start?</h4>
            <p class="text-muted-foreground">We can usually launch your campaigns within 5-7 business days after our kickoff call.</p>
        </div>
        <div>
            <h4 class="font-semibold">Do you guarantee leads?</h4>
            <p class="text-muted-foreground">While we can't control the market, we don't charge our management fee if we don't hit our agreed-upon KPIs in the first 90 days.</p>
        </div>
    </div>
    <div class="mt-8">
        <a href="#faq" class="text-primary font-semibold hover:underline">See full FAQ below &darr;</a>
    </div>
  </div>
</section>
