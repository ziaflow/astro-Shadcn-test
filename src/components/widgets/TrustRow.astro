---
import { Star } from "lucide-react";
import { Logo1, Logo2, Logo3, Logo4, Logo5 } from "./Logos";

const metrics = [
  { value: "40%+", label: "Avg Lead Increase" },
  { value: "500+", label: "Businesses Served" },
  { value: "4.9/5", label: "Client Satisfaction" },
];
---

<section class="container py-24 sm:py-32 bg-muted/30">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <div class="space-y-8">
       <h2 class="text-3xl font-bold">Trusted by Home Service Pros</h2>
       <div class="flex gap-2 text-yellow-500">
          {[...Array(5)].map(() => <Star className="fill-current w-6 h-6" />)}
       </div>
       <p class="text-lg text-muted-foreground">
         "ZiaFlow transformed our business. We went from wondering where the next job was coming from to being booked out weeks in advance."
       </p>
       <div class="font-semibold">- Owner, Arizona HVAC Pros</div>
    </div>

    <div class="grid sm:grid-cols-3 gap-8">
        {metrics.map(m => (
            <div class="text-center p-6 bg-background rounded-lg shadow-sm">
                <div class="text-3xl font-bold text-primary mb-2">{m.value}</div>
                <div class="text-sm text-muted-foreground font-medium">{m.label}</div>
            </div>
        ))}
    </div>
  </div>

  <div class="mt-16 pt-8 border-t border-muted-foreground/10">
      <p class="text-center text-sm font-semibold text-muted-foreground mb-6 uppercase tracking-wider">Powering Growth For</p>
      <div class="flex flex-wrap justify-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition-all duration-500">
          <Logo1 className="h-8 w-auto text-primary" />
          <Logo2 className="h-8 w-auto text-primary" />
          <Logo3 className="h-8 w-auto text-primary" />
          <Logo4 className="h-8 w-auto text-primary" />
          <Logo5 className="h-8 w-auto text-primary" />
      </div>
  </div>
</section>
