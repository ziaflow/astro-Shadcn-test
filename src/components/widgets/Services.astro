---
import { Card, CardHeader, CardTitle, CardDescription, CardFooter } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { ArrowRight, Search, MapPin, Star, BarChart, Settings } from "lucide-react";

const services = [
  {
    title: "Google LSAs",
    description: "Get verified leads directly from Google at the very top of search results.",
    icon: Search,
  },
  {
    title: "GMB Optimization",
    description: "Rank in the Local Pack and turn searchers into callers with a polished profile.",
    icon: MapPin,
  },
  {
    title: "Review & Reputation",
    description: "Automate review requests and manage your online reputation effortlessly.",
    icon: Star,
  },
  {
    title: "CRO/Booking Optimization",
    description: "Turn more website visitors into booked appointments with friction-free forms.",
    icon: BarChart,
  },
  {
    title: "Automation",
    description: "Follow up with leads instantly via SMS and email to secure the job first.",
    icon: Settings,
  },
];
---

<section id="services" class="container py-24 sm:py-32 bg-secondary/20">
  <div class="text-center md:w-3/4 mx-auto space-y-4 mb-16">
    <h2 class="text-3xl md:text-4xl font-bold">Specialized Growth Services</h2>
    <p class="text-xl text-muted-foreground">
      Everything you need to dominate your local market.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {services.map((service) => (
      <Card className="hover:shadow-lg transition-shadow">
        <CardHeader>
            <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
                <service.icon className="w-6 h-6 text-primary" />
            </div>
          <CardTitle>{service.title}</CardTitle>
          <CardDescription className="text-base mt-2">{service.description}</CardDescription>
        </CardHeader>
        <CardFooter>
            <a href="#" class="flex items-center text-primary font-semibold hover:underline">
                Learn more <ArrowRight className="ml-2 w-4 h-4" />
            </a>
        </CardFooter>
      </Card>
    ))}
  </div>
</section>
