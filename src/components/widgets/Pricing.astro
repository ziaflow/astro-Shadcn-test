---
import { Button } from "@/components/ui/button";
import { Card, CardHeader, CardTitle, CardContent, CardDescription, CardFooter } from "@/components/ui/card";
import { Check } from "lucide-react";

const plans = [
  {
    name: "Starter",
    price: "$1,500 - $2,500",
    description: "Perfect for establishing your local presence.",
    features: ["Google Business Profile Optimization", "Review Management", "Basic LSA Setup"],
  },
  {
    name: "Growth",
    price: "$3,000 - $5,000",
    description: "Accelerate lead generation and booking volume.",
    features: ["Everything in Starter", "Advanced CRO Landing Page", "PPC Management", "Automated Follow-ups"],
    popular: true,
  },
  {
    name: "Enterprise",
    price: "Custom",
    description: "Dominating market share in multiple territories.",
    features: ["Everything in Growth", "Multi-Location SEO", "Dedicated Account Manager", "Priority Support"],
  },
];
---

<section id="pricing" class="container py-24 sm:py-32 bg-secondary/20">
  <div class="text-center md:w-3/4 mx-auto space-y-4 mb-16">
    <h2 class="text-3xl md:text-4xl font-bold">Transparent Pricing</h2>
    <p class="text-xl text-muted-foreground">
      Invest in growth, not guesswork.
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-8">
    {plans.map((plan) => (
      <Card className={plan.popular ? "border-primary border-2 shadow-lg scale-105" : ""}>
        <CardHeader>
          <CardTitle className="flex justify-between items-center">
            {plan.name}
            {plan.popular && <span class="text-xs bg-primary text-primary-foreground px-2 py-1 rounded-full">Most Popular</span>}
          </CardTitle>
          <div class="text-3xl font-bold mt-2">{plan.price}</div>
          <CardDescription>{plan.description}</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="space-y-2">
            {plan.features.map((feature) => (
              <li class="flex items-center">
                <Check className="w-4 h-4 text-primary mr-2" />
                <span class="text-sm">{feature}</span>
              </li>
            ))}
          </ul>
        </CardContent>
        <CardFooter>
          <Button className="w-full" variant={plan.popular ? "default" : "outline"}>Get Quote</Button>
        </CardFooter>
      </Card>
    ))}
  </div>
</section>
